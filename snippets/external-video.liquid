{%- doc -%}
  Renders an external video (YouTube or Vimeo) iframe from a video URL
  
  @param {string} video_url - The full YouTube or Vimeo URL (supports Vimeo privacy hashes)
  @param {string} [class] - Additional classes for the iframe
  @param {string} [testid] - Data-testid attribute for testing
  @param {boolean} [autoplay] - Whether the video should autoplay (default: true)
  @param {boolean} [loop] - Whether the video should loop (default: true)
  @param {boolean} [muted] - Whether the video should be muted (default: true)
  @param {boolean} [controls] - Whether to show controls (default: false)
  
  @example
  {% render 'external-video', video_url: 'https://www.youtube.com/watch?v=VIDEO_ID', class: 'hero__video' %}
  {% render 'external-video', video_url: 'https://vimeo.com/1133751850/6d211d2b8e', class: 'hero__video' %}
{%- enddoc -%}

{% liquid
  assign autoplay = autoplay | default: true
  assign loop = loop | default: true
  assign muted = muted | default: true
  assign controls = controls | default: false
  
  assign video_id = blank
  assign video_type = blank
  assign vimeo_privacy_hash = blank
  
  # Detect YouTube URL and extract ID
  if video_url contains 'youtube.com/watch?v='
    assign video_id = video_url | split: 'watch?v=' | last | split: '&' | first
    assign video_type = 'youtube'
  elsif video_url contains 'youtu.be/'
    assign video_id = video_url | split: 'youtu.be/' | last | split: '?' | first
    assign video_type = 'youtube'
  elsif video_url contains 'youtube.com/embed/'
    assign video_id = video_url | split: 'embed/' | last | split: '?' | first
    assign video_type = 'youtube'
  # Detect Vimeo URL and extract ID (with optional privacy hash)
  elsif video_url contains 'vimeo.com/'
    assign url_parts = video_url | split: 'vimeo.com/'
    if url_parts.size > 1
      assign path_part = url_parts | last
      # Extract video ID (first part after vimeo.com/)
      assign video_id = path_part | split: '/' | first | split: '?' | first
      # Check for privacy hash (second part in path like /VIDEO_ID/HASH)
      assign path_segments = path_part | split: '/'
      if path_segments.size > 1
        assign potential_hash = path_segments[1] | split: '?' | first
        # Vimeo privacy hashes are typically 10 characters
        if potential_hash.size > 0
          assign vimeo_privacy_hash = potential_hash
        endif
      endif
      assign video_type = 'vimeo'
    endif
  endif
%}

{% if video_id != blank and video_type != blank %}
  {% liquid
    if video_type == 'youtube'
      assign embed_url = 'https://www.youtube.com/embed/' | append: video_id | append: '?'
      
      if autoplay
        assign embed_url = embed_url | append: 'autoplay=1&'
      endif
      
      if muted
        assign embed_url = embed_url | append: 'mute=1&'
      endif
      
      if loop
        assign embed_url = embed_url | append: 'loop=1&playlist=' | append: video_id | append: '&'
      endif
      
      if controls == false
        assign embed_url = embed_url | append: 'controls=0&'
      endif
      
      assign embed_url = embed_url | append: 'playsinline=1&modestbranding=1&rel=0'
      
    elsif video_type == 'vimeo'
      assign embed_url = 'https://player.vimeo.com/video/' | append: video_id | append: '?'
      
      if vimeo_privacy_hash != blank
        assign embed_url = embed_url | append: 'h=' | append: vimeo_privacy_hash | append: '&'
      endif
      
      if autoplay
        assign embed_url = embed_url | append: 'autoplay=1&'
      endif
      
      if muted
        assign embed_url = embed_url | append: 'muted=1&'
      endif
      
      if loop
        assign embed_url = embed_url | append: 'loop=1&'
      endif
      
      if controls == false
        assign embed_url = embed_url | append: 'controls=0&'
      endif
      
      assign embed_url = embed_url | append: 'background=1&byline=0&title=0'
    endif
  %}
  
  <iframe
    src="{{ embed_url }}"
    class="external-video-iframe {{ class }}"
    {% if testid %}data-testid="{{ testid }}"{% endif %}
    frameborder="0"
    allow="autoplay; fullscreen; picture-in-picture; encrypted-media"
    allowfullscreen
    loading="eager"
    style="border: none;"
  ></iframe>
{% endif %}

{% stylesheet %}
  .external-video-iframe {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* Ensure the iframe covers the container */
  .hero__video-wrapper--desktop .external-video-iframe,
  .hero__video-wrapper--mobile .external-video-iframe {
    min-height: 100%;
  }
{% endstylesheet %}

{% if section.settings.hero_image != blank %}
  {% assign image = section.settings.hero_image %}
  <section class="aop-hero-section" role="region" aria-label="Art of Pairing Hero">
    <img 
      src="{{ image | image_url: width: 1280 }}" 
      srcset="{{ image | image_url: width: 640 }} 640w, {{ image | image_url: width: 1280 }} 1280w"
      sizes="100vw"
      alt="{{ section.settings.hero_heading | escape }}"
      loading="lazy"
      class="aop-hero-img"
      width="100%"
      height="100%"
    >

    <!-- <div class="hero-vector-frame" aria-hidden="true"></div>     -->
    <!-- <div class="hero-outline-frame" aria-hidden="true"></div>    
    <div class="text-gradient-bg" aria-hidden="true"></div> -->
    {% comment %} <div class="hero-outline-frame" aria-hidden="true">
      <img 
        src="https://cdn.shopify.com/s/files/1/0581/7362/0405/files/Subtract.svg?v=1755596030" 
        alt=""
        loading="lazy"
        width="100%"
        height="100%"
        >
    </div> {% endcomment %}
    <div class="text-gradient-bg" aria-hidden="true">
        <img 
        src="https://cdn.shopify.com/s/files/1/0581/7362/0405/files/Rectangle_52.png?v=1755596032" 
        alt=""
        loading="lazy"
        width="100%"
        height="100%"
        >
    </div>
    {% if section.settings.hero_heading != blank %}
      <div class="aop-hero-overlay">
        <h1>{{ section.settings.hero_heading | escape }}</h1>
      </div>
    {% endif %}
  </section>
{% endif %}


{% schema %}
{
  "name": "Hero Image",
  "tag": "section",
  "class": "aop-hero-container",
  "settings": [
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Hero Image",
      "info": "Upload a high-resolution image for the hero section. 1280 x 550px is recommended."
    },
    {
      "type": "text",
      "id": "hero_heading",
      "label": "Hero Heading",
      "default": "THE ART OF PAIRING"
    }
  ],
  "presets": [
    {
      "name": "Hero Image",
      "category": "3) Static content"
    }
  ]
}
{% endschema %}

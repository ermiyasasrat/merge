{{- 'logo-slider.css' | asset_url | stylesheet_tag -}}

<script src="{{ 'logo-slider.js' | asset_url }}" type="module" fetchpriority="low"></script>

{% liquid
  # Calculate visible logos based on screen size
  assign logos_per_view_desktop = section.settings.logos_per_view_desktop | default: 4
  assign logos_per_view_mobile = section.settings.logos_per_view_mobile | default: 2
  assign gap = section.settings.gap_between_logos | default: 32

  # Only show slider if we have logos
  assign has_logos = false
  if section.blocks.size > 0
    assign has_logos = true
  endif
%}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>

<logo-slider-component
  class="logo-slider section spacing-style section--{{ section.settings.section_width }} color-{{ section.settings.color_scheme }}"
  style="{% render 'spacing-padding', settings: section.settings %}"
  data-autoplay="{{ section.settings.autoplay }}"
  data-autoplay-speed="{{ section.settings.autoplay_speed }}"
  data-logos-per-view-desktop="{{ logos_per_view_desktop }}"
  data-logos-per-view-mobile="{{ logos_per_view_mobile }}"
  {% if section.settings.autoplay %}
    autoplay="{{ section.settings.autoplay_speed }}"
  {% endif %}
>
  {% if section.settings.heading != blank %}
    <div class="logo-slider__header">
      <h2 class="logo-slider__heading">{{ section.settings.heading }}</h2>
    </div>
  {% endif %}

  <div class="logo-slider__controls-wrapper">
    <div class="logo-slider__track-container" ref="trackContainer">
      <ul
        class="logo-slider__track"
        ref="track"
        role="list"
        aria-label="{{ section.settings.heading | default: 'Logo slider' }}"
        style="--gap: {{ gap }}px; --logos-per-view-desktop: {{ logos_per_view_desktop }}; --logos-per-view-mobile: {{ logos_per_view_mobile }};"
      >
        {% for block in section.blocks %}
          <li
            class="logo-slider__slide"
            {{ block.shopify_attributes }}
            data-slide-index="{{ forloop.index0 }}"
          >
            {% if block.settings.link != blank %}
              <a
                href="{{ block.settings.link }}"
                class="logo-slider__logo-link"
                {% if block.settings.image != blank %}
                  aria-label="{{ block.settings.image.alt | default: shop.name }}"
                {% endif %}
              >
            {% endif %}

            {% if block.settings.image != blank %}
              {{
                block.settings.image
                | image_url: width: 400
                | image_tag:
                  loading: 'lazy',
                  class: 'logo-slider__image',
                  widths: '100, 150, 200, 300, 400',
                  alt: block.settings.image.alt
                | default: shop.name
              }}
            {% else %}
              <div class="logo-slider__placeholder">
                {{ 'image' | placeholder_svg_tag: 'logo-slider__placeholder-svg' }}
              </div>
            {% endif %}

            {% if block.settings.link != blank %}
              </a>
            {% endif %}
          </li>
        {% endfor %}
      </ul>
    </div>
  </div>
</logo-slider-component>

{% schema %}
{
  "name": "Logo Slider",
  "tag": "section",
  "class": "logo-slider-section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Our Partners"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Slider settings"
    },
    {
      "type": "range",
      "id": "logos_per_view_desktop",
      "label": "Logos per view (desktop)",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 4,
      "info": "Number of logos visible at once on desktop screens"
    },
    {
      "type": "range",
      "id": "logos_per_view_mobile",
      "label": "Logos per view (mobile)",
      "min": 1,
      "max": 3,
      "step": 1,
      "default": 2,
      "info": "Number of logos visible at once on mobile screens"
    },
    {
      "type": "range",
      "id": "gap_between_logos",
      "label": "Gap between logos",
      "min": 8,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Auto-rotate slides",
      "default": true
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "label": "Auto-rotate speed",
      "min": 1,
      "max": 10,
      "step": 1,
      "unit": "s",
      "default": 5,
      "info": "Time between slide changes"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        {
          "value": "page-width",
          "label": "Page width"
        },
        {
          "value": "full-width",
          "label": "Full width"
        }
      ],
      "default": "page-width"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "logo",
      "name": "Logo",
      "limit": 12,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Logo image",
          "info": "Recommended: SVG or PNG with transparent background"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link",
          "info": "Optional URL when clicking the logo"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Logo Slider",
      "category": "Image",
      "blocks": [
        {
          "type": "logo"
        },
        {
          "type": "logo"
        },
        {
          "type": "logo"
        },
        {
          "type": "logo"
        },
        {
          "type": "logo"
        },
        {
          "type": "logo"
        }
      ]
    }
  ]
}
{% endschema %}
